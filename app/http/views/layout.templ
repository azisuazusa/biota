package views

type navItem struct {
	key, label, href string
}

var navItems = []navItem{
	{"dashboard", "Dashboard", "/"},
	{"upload", "Unggah Data", "/upload"},
	{"status", "Status", "/settings/status"},
	{"products", "Produk", "/settings/products"},
	{"sku-mapping", "Pemetaan SKU", "/settings/sku-mapping"},
}

// htmxConfig lets HTMX swap 4xx/5xx responses so inline errors and the
// #flash alert are shown.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[2345]..","swap":true}]}`

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } · BIOTA Sales Insight</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script defer src="/static/vendor/htmx.min.js"></script>
			<script defer src="/static/vendor/chart.umd.min.js"></script>
			<script defer src="/static/js/charts.js"></script>
			<script defer src="/static/vendor/alpine.min.js"></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
			<header class="border-b border-slate-200 bg-white">
				<nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
					<a href="/" class="font-semibold text-emerald-700">BIOTA Sales Insight</a>
					<div class="flex flex-wrap items-center gap-x-1 gap-y-1 text-sm">
						for i, n := range navItems {
							if i == 2 {
								<span class="ml-3 mr-1 text-xs uppercase tracking-wide text-slate-400">Pengaturan</span>
							}
							<a
								href={ templ.SafeURL(n.href) }
								class={ "rounded-md px-3 py-1.5", templ.KV("bg-emerald-50 font-medium text-emerald-800", n.key == active), templ.KV("text-slate-600 hover:bg-slate-100", n.key != active) }
							>{ n.label }</a>
						}
					</div>
				</nav>
			</header>
			<main class="mx-auto max-w-7xl px-4 py-6">
				<div id="flash"></div>
				{ children... }
			</main>
		</body>
	</html>
}

// Section is a titled white card.
templ Section(title string) {
	<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<h2 class="mb-4 text-base font-semibold text-slate-900">{ title }</h2>
		{ children... }
	</section>
}
