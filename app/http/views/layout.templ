package views

type navItem struct {
	key, label, href string
}

var navItems = []navItem{
	{"dashboard", "Dashboard", "/"},
	{"upload", "Unggah Data", "/upload"},
}

// settingsItems are grouped under the "Pengaturan" dropdown.
var settingsItems = []navItem{
	{"status", "Status", "/settings/status"},
	{"products", "Produk", "/settings/products"},
	{"sku-mapping", "Pemetaan SKU", "/settings/sku-mapping"},
}

func isSettings(active string) bool {
	for _, n := range settingsItems {
		if n.key == active {
			return true
		}
	}
	return false
}

// htmxConfig lets HTMX swap 4xx/5xx responses so inline errors and the
// #flash alert are shown.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[2345]..","swap":true}]}`

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } · BIOTA Sales Insight</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script defer src="/static/vendor/htmx.min.js"></script>
			<script defer src="/static/vendor/chart.umd.min.js"></script>
			<script defer src="/static/js/charts.js"></script>
			<script defer src="/static/vendor/alpine.min.js"></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
			<header class="border-b border-slate-200 bg-white">
				<nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
					<a href="/" class="font-semibold text-emerald-700">BIOTA Sales Insight</a>
					<div class="flex flex-wrap items-center gap-x-1 gap-y-1 text-sm">
						for _, n := range navItems {
							<a
								href={ templ.SafeURL(n.href) }
								class={ "rounded-md px-3 py-1.5", templ.KV("bg-emerald-50 font-medium text-emerald-800", n.key == active), templ.KV("text-slate-600 hover:bg-slate-100", n.key != active) }
							>{ n.label }</a>
						}
						<div class="relative" x-data="{ open: false }" @keydown.escape.window="open = false" @click.outside="open = false">
							<button
								type="button"
								class={ "inline-flex items-center gap-1 rounded-md px-3 py-1.5", templ.KV("bg-emerald-50 font-medium text-emerald-800", isSettings(active)), templ.KV("text-slate-600 hover:bg-slate-100", !isSettings(active)) }
								aria-haspopup="menu"
								:aria-expanded="open.toString()"
								@click="open = !open"
							>
								Pengaturan
								<svg class="h-4 w-4 transition-transform" :class="open && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
								</svg>
							</button>
							<div
								x-show="open"
								x-cloak
								x-transition.origin.top.left
								role="menu"
								class="absolute left-0 z-20 mt-1 w-48 rounded-lg border border-slate-200 bg-white py-1 shadow-lg"
							>
								for _, n := range settingsItems {
									<a
										href={ templ.SafeURL(n.href) }
										role="menuitem"
										class={ "block px-4 py-2", templ.KV("bg-emerald-50 font-medium text-emerald-800", n.key == active), templ.KV("text-slate-700 hover:bg-slate-100", n.key != active) }
									>{ n.label }</a>
								}
							</div>
						</div>
					</div>
				</nav>
			</header>
			<main class="mx-auto max-w-7xl px-4 py-6">
				<div id="flash"></div>
				{ children... }
			</main>
		</body>
	</html>
}

// Section is a titled white card.
templ Section(title string) {
	<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<h2 class="mb-4 text-base font-semibold text-slate-900">{ title }</h2>
		{ children... }
	</section>
}
